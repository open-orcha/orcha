<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Hardened Runtime entitlements required for notarizing an Electron app.
    Electron/V8 JIT-compile JavaScript, so the runtime needs to allocate
    executable memory; Apple's notary service rejects hardened-runtime builds
    that lack these. Kept to the minimum Electron needs.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Dictation: hardened runtime blocks the microphone without this (TCC then never prompts). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!--
    Widget bridge (GH #397): the App Group the WidgetKit extension shares with the app.
    It must be prefixed with the signing TeamIdentifier (the Developer ID team). The app
    reads this entitlement at startup and only writes there; without it, it writes
    nothing. Main app only: nested helpers/the Python sidecar sign with
    entitlements.mac.inherit.plist, which has no group.
  -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>FX6LQ4M698.orcha</string>
  </array>
</dict>
</plist>
