{
  "name": "orcha-desktop",
  "version": "1.2.0",
  "description": "Embodent — desktop stack manager for orcha-* Docker stacks (Orcha#237)",
  "main": "./out/main/index.js",
  "author": "Orcha",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs && node scripts/fix-node-pty.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pretest": "node scripts/fix-node-pty.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "prebuild": "node scripts/ensure-electron.mjs && node scripts/fix-node-pty.mjs",
    "predist:mac": "node scripts/ensure-electron.mjs && node scripts/fix-node-pty.mjs && node scripts/build-orcha-runtime.mjs --clean",
    "predist:mac:arm64": "node scripts/ensure-electron.mjs && node scripts/fix-node-pty.mjs && node scripts/build-orcha-runtime.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac --universal",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac --arm64",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dist:dir": "electron-vite build && electron-builder --mac --dir -c.mac.notarize=false",
    "predist:dir": "node scripts/ensure-electron.mjs && node scripts/fix-node-pty.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "node-pty": "1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.11"
  }
}
