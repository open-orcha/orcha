{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha poll-inbox"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha file-guard"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha watch --detach"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha rehydrate"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha notifier --ensure"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha terminal-bridge --ensure"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha reachability --quiet"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha unwatch"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha snapshot"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha task-claim-guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha file-guard"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha conv-guard"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha file-guard",
            "timeout": 660
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
