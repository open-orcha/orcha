            "title": "Purpose"
          },
          "missing_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Missing Reason"
          },
          "terminal_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terminal Cause"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "frozen_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frozen At"
          },
          "source_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Revision"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SavedEvidenceItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "evidence_set_id",
          "task_id",
          "workflow_id",
          "workflow_execution_id",
          "run_id",
          "work_revision",
          "result_revision",
          "source_sequence",
          "generation",
          "state",
          "purpose",
          "missing_reason",
          "terminal_cause",
          "created_at",
          "frozen_at",
          "source_revision",
          "items"
        ],
        "title": "SavedEvidenceSet"
