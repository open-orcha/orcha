{
  "openapi": "3.1.0",
  "info": {
    "title": "Orcha API",
    "version": "0.6.0"
  },
  "paths": {
    "/api/workflows/{wid}/tasks/{tid}/evidence": {
      "get": {
        "summary": "Get Workflow Task Evidence",
        "operationId": "get_workflow_task_evidence_api_workflows__wid__tasks__tid__evidence_get",
        "parameters": [
          {
            "name": "wid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Wid"
            }
          },
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tid"
            }
          },
          {
            "name": "before_revision",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before Revision"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowTaskEvidence"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SavedEvidenceItem": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "deliverable_id": {
            "type": "string",
            "title": "Deliverable Id"
          },
          "deliverable_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Deliverable Version"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          },
          "kind": {
            "type": "string",
            "enum": [
              "result_summary",
              "file_changes",
              "log_excerpt",
              "owner_result",
              "outside_result",
              "import_result"
            ],
            "title": "Kind"
          },
          "source": {
            "type": "string",
            "enum": [
              "worker",
              "owner",
              "outside",
              "import",
              "cancelled_attempt",
              "released_attempt"
            ],
            "title": "Source"
          },
          "snapshot_phase": {
            "type": "string",
            "enum": [
              "submission",
              "terminal"
            ],
            "title": "Snapshot Phase"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "storage_state": {
            "type": "string",
            "enum": [
              "readable",
              "missing",
              "corrupt",
              "missing_after_restore"
            ],
            "title": "Storage State"
          },
          "captured_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captured By"
          },
          "captured_by_alias": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captured By Alias"
          },
          "captured_by_kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "human",
                  "ai"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Captured By Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "item_id",
          "deliverable_id",
          "deliverable_version",
          "sha256",
          "kind",
          "source",
          "snapshot_phase",
          "complete",
          "note",
          "storage_state"
        ],
        "title": "SavedEvidenceItem"
      },
