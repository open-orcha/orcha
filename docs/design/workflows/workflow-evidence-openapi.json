        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "workflow_id": {
            "type": "string",
            "title": "Workflow Id"
          },
          "current_evidence_set_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Evidence Set Id"
          },
          "sets": {
            "items": {
              "$ref": "#/components/schemas/SavedEvidenceSet"
            },
            "type": "array",
            "title": "Sets"
          },
          "next_before_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Before Revision"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "workflow_id",
          "current_evidence_set_id",
          "sets"
