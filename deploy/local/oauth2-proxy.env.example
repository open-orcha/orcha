# Copy to oauth2-proxy.env beside this file and fill in. Never commit oauth2-proxy.env.
#
#   cp deploy/local/oauth2-proxy.env.example deploy/local/oauth2-proxy.env
#
# See deploy/local/README.md → "Optional: real login on localhost" for the
# full walkthrough (creating the GitHub OAuth app, which port to point at,
# how to bring the overlay up).

# GitHub OAuth app (https://github.com/settings/developers -> New OAuth App).
#   Homepage URL:  http://localhost:4180
#   Callback URL:  http://localhost:4180/oauth2/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub usernames allowed to sign in (empty = anyone with a
# GitHub account; fine for a single-operator laptop, tighten it if you don't
# want that).
ALLOWED_GITHUB_USERS=

# Session cookie signing key. Generate with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
COOKIE_SECRET=

# The portal's HOST port, as printed by `orcha init` / recorded in
# .claude/orcha.json ("api_port"). Default is 8000; a second local project
# shifts up (8001, 8002, ...). The overlay proxies to
# host.docker.internal:$ORCHA_PORTAL_PORT so oauth2-proxy (in its own
# container) can reach the portal's host-published port regardless of which
# compose project rendered it.
ORCHA_PORTAL_PORT=8000
