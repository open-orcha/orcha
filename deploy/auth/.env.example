# Copy to .env beside this file and fill in. Never commit .env.

# The public hostname for this box (DNS A record must point here).
ORCHA_DOMAIN=orcha.example.com
# Where Let's Encrypt sends expiry mail.
ACME_EMAIL=you@example.com

# The orcha stack's compose network on this box: orcha-<project>_default
# (find it with: docker network ls | grep orcha)
ORCHA_STACK_NETWORK=orcha-myproj_default

# GitHub OAuth app (https://github.com/settings/developers → New OAuth App;
# callback URL: https://$ORCHA_DOMAIN/oauth2/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed into the portal (the team roster).
ALLOWED_GITHUB_USERS=hussein-quant

# Session cookie key: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
COOKIE_SECRET=

# The bearer token for the iOS app + external agent API callers.
# Generate:      python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Rotate by editing here + `docker compose up -d`.
ORCHA_TEAM_TOKEN=
