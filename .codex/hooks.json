{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha file-guard",
            "timeout": 660
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha file-guard"
          }
        ],
        "matcher": "apply_patch|Edit|Write"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orcha file-guard"
          }
        ]
      }
    ]
  }
}
